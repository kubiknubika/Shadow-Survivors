<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Игра рисует программно и отдаёт кадр через GLES2-текстуру. -->
    <uses-feature android:glEsVersion="0x00020000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="false"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- Системная активность: она поднимает libshadow_survivors.so и зовёт
             ANativeActivity_onCreate. Своего Java-кода в проекте нет. -->
        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|density|uiMode">

            <meta-data android:name="android.app.lib_name" android:value="shadow_survivors" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
